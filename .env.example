# PostHog project API key (public). Leave unset to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional; defaults to https://us.i.posthog.com (use https://eu.i.posthog.com for EU)
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase (accounts). Use the publishable key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
