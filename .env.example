# PostHog project API key (public). Leave unset to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Leave unset on Netlify: analytics then go through this site's relay
# (netlify/edge-functions/posthog-relay.ts) to PostHog's US cloud. Set it to
# https://us.i.posthog.com when running without Netlify (npm run dev), where the relay doesn't exist.
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase (accounts). Use the publishable key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paid-idea test buttons. "off" hides all three; leave unset to show them.
NEXT_PUBLIC_TEST_BUTTONS=
# Cloudflare Turnstile site key for the sign-in check. Leave unset for no check.
# The secret key goes in Supabase (Authentication > Attack Protection), never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Stripe Payment Links for the pre-orders, and the customer portal's login link.
# Only https://buy.stripe.com/... (payment) and https://billing.stripe.com/... (portal)
# links are used; anything else counts as unset. No Stripe keys go anywhere in the site.
NEXT_PUBLIC_STRIPE_LINK_MEMBERSHIP=
NEXT_PUBLIC_STRIPE_LINK_REPORT=
NEXT_PUBLIC_STRIPE_PORTAL_LINK=

# Member emails (netlify/functions/owner-emails.mts). Server only: never NEXT_PUBLIC_.
# off (or unset) sends nothing; preview sends every email to support@; live sends to members.
OWNER_EMAILS_MODE=
RESEND_API_KEY=
SUPABASE_SECRET_KEY=
